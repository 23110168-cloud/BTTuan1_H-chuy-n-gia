


-- Bảng KhoHang
CREATE TABLE KhoHang (
    MaKhoHang NVARCHAR(10) CONSTRAINT PK_KhoHang PRIMARY KEY,
    TenKhoHang NVARCHAR(100) NOT NULL,
    DiaChi NVARCHAR(255) NOT NULL
);
GO

-- Bảng LoaiSanPham
CREATE TABLE LoaiSanPham (
    MaLoaiSP NVARCHAR(10) CONSTRAINT PK_LoaiSanPham PRIMARY KEY,
    TenLoaiSP NVARCHAR(100) NOT NULL
);
GO

-- Bảng SanPham
CREATE TABLE SanPham (
    MaSP NVARCHAR(10) CONSTRAINT PK_SanPham PRIMARY KEY,
    TenSP NVARCHAR(100) NOT NULL,
    Gia DECIMAL(10,2) NOT NULL CHECK (Gia > 0),
    SoLuong INT NOT NULL CHECK (SoLuong >= 0),
    MaLoaiSP NVARCHAR(10),
    MaKhoHang NVARCHAR(10),
    CONSTRAINT FK_SanPham_LSP FOREIGN KEY (MaLoaiSP) REFERENCES LoaiSanPham(MaLoaiSP),
    CONSTRAINT FK_SanPham_Kho FOREIGN KEY (MaKhoHang) REFERENCES KhoHang(MaKhoHang)
);
GO

-- Bảng PhanCong
CREATE TABLE PhanCong (
    MaPhanCong NVARCHAR(10) CONSTRAINT PK_PhanCong PRIMARY KEY,
    NgayPhanCong NVARCHAR(10) NOT NULL
);
GO


-- Bảng NhanVien
CREATE TABLE NhanVien (
    MaNV NVARCHAR(10) CONSTRAINT PK_NhanVien PRIMARY KEY,
    Ho NVARCHAR(50) NOT NULL,
    Ten NVARCHAR(50) NOT NULL,
    DiaChi NVARCHAR(255) NOT NULL,
    SoDT NVARCHAR(15) NOT NULL UNIQUE,
    SoNgayLam INT NOT NULL CHECK (SoNgayLam >= 0),
	LuongMotNgay DECIMAL(10,2) NOT NULL CHECK (LuongMotNgay > 0),
    Luong DECIMAL(10,2) NOT NULL CHECK (Luong > 0),
    TaiKhoan NVARCHAR(50) UNIQUE NOT NULL,
    MatKhau NVARCHAR(255) NOT NULL,
    ChucVu NVARCHAR(50) NOT NULL CHECK (ChucVu IN ('QuanLy', 'NhanVien')),
    MaPhanCong NVARCHAR(10) NOT NULL,
    CONSTRAINT FK_NhanVien_PhanCong FOREIGN KEY (MaPhanCong) REFERENCES PhanCong(MaPhanCong) 
);
GO

-- Bảng HoaDon
CREATE TABLE HoaDon (
    MaHD NVARCHAR(10) CONSTRAINT PK_HoaDon PRIMARY KEY,
    NgayLap DATE NOT NULL CHECK (NgayLap <= GETDATE()),
    TongTien DECIMAL(15,2) NOT NULL CHECK (TongTien >= 0),
    MaNV NVARCHAR(10) NOT NULL,
    CONSTRAINT FK_HoaDon_NhanVien FOREIGN KEY (MaNV) REFERENCES NhanVien(MaNV)
);
GO

-- Bảng ChiTietHoaDon
CREATE TABLE ChiTietHoaDon (
    MaHD NVARCHAR(10),
    MaSP NVARCHAR(10),
    SoLuong INT NOT NULL CHECK (SoLuong > 0),
    CONSTRAINT PK_ChiTietHoaDon PRIMARY KEY (MaHD, MaSP),
    CONSTRAINT FK_ChiTietHoaDon_HoaDon FOREIGN KEY (MaHD) REFERENCES HoaDon(MaHD),
    CONSTRAINT FK_ChiTietHoaDon_SanPham FOREIGN KEY (MaSP) REFERENCES SanPham(MaSP)
);
GO

-- Bảng PhuongThucThanhToan
CREATE TABLE PhuongThucThanhToan (
    MaPTTT NVARCHAR(10) CONSTRAINT PK_PhuongThucThanhToan PRIMARY KEY,
    TenPTTT NVARCHAR(100) NOT NULL
);
GO

-- Bảng KhachHang
CREATE TABLE KhachHang (
    MaKH NVARCHAR(10) CONSTRAINT PK_KhachHang PRIMARY KEY,
    Ho NVARCHAR(50) NOT NULL,
    Ten NVARCHAR(50) NOT NULL,
    SoDT NVARCHAR(15) NOT NULL UNIQUE
);
GO

-- Bảng ThanhToanHoaDon
CREATE TABLE ThanhToanHoaDon (
    MaHD NVARCHAR(10),
    MaKH NVARCHAR(10),
    MaPTTT NVARCHAR(10),
    TrangThaiThanhToan NVARCHAR(50) NOT NULL CHECK (TrangThaiThanhToan IN ('Chua Thanh Toan', 'Da Thanh Toan')),
    CONSTRAINT PK_ThanhToanHoaDon PRIMARY KEY (MaHD, MaKH, MaPTTT),
    CONSTRAINT FK_ThanhToanHoaDon_HoaDon FOREIGN KEY (MaHD) REFERENCES HoaDon(MaHD),
    CONSTRAINT FK_ThanhToanHoaDon_KhachHang FOREIGN KEY (MaKH) REFERENCES KhachHang(MaKH),
    CONSTRAINT FK_ThanhToanHoaDon_PTTT FOREIGN KEY (MaPTTT) REFERENCES PhuongThucThanhToan(MaPTTT)
);
GO

