AS
BEGIN
    -- Thêm khách hàng
    INSERT INTO KhachHang (MaKH, Ho, Ten, SoDT)
    VALUES (@MaKH, @Ho, @Ten, @SoDT);
END;
GO

--Cap Nhat
CREATE PROCEDURE spCapNhatKhachHang
    @MaKH NVARCHAR(10),
    @Ho NVARCHAR(50),
    @Ten NVARCHAR(50),
    @SoDT NVARCHAR(15)
AS
BEGIN
    -- Cập nhật thông tin khách hàng
    UPDATE KhachHang
    SET Ho = @Ho, Ten = @Ten, SoDT = @SoDT
    WHERE MaKH = @MaKH;
END;
GO

--Xoa
CREATE PROCEDURE spXoaKhachHang
    @MaKH NVARCHAR(10)
AS
BEGIN
    -- Xóa khách hàng
    DELETE FROM KhachHang WHERE MaKH = @MaKH;
END;
GO

--===================================================
--PROCEDURE thêm, cập nhật, xóa ThanhToanHoaDon
--===================================================
--Them
CREATE PROCEDURE spThemThanhToanHoaDon
    @MaHD NVARCHAR(10),
    @MaKH NVARCHAR(10),
    @MaPTTT NVARCHAR(10),
    @TrangThaiThanhToan NVARCHAR(50)
AS
BEGIN

    -- Kiểm tra tính hợp lệ của Trạng thái thanh toán
    IF @TrangThaiThanhToan NOT IN ('Chua Thanh Toan', 'Da Thanh Toan')
    BEGIN
        PRINT N'Trang thái thanh toán không hợp lệ!';
        RETURN;
    END

    -- Chèn dữ liệu vào bảng ThanhToanHoaDon
    BEGIN TRY
        INSERT INTO ThanhToanHoaDon (MaHD, MaKH, MaPTTT, TrangThaiThanhToan)
        VALUES (@MaHD, @MaKH, @MaPTTT, @TrangThaiThanhToan);

        PRINT N'Thêm thanh toán hóa đơn thành công!';
    END TRY
    BEGIN CATCH
        PRINT N'Lỗi khi thêm thanh toán hóa đơn: ' + ERROR_MESSAGE();
    END CATCH
END;
GO

--Cap Nhat
CREATE PROCEDURE spCapNhatThanhToanHoaDon
    @MaHD NVARCHAR(10),
    @MaKH NVARCHAR(10),
    @MaPTTT NVARCHAR(10),
    @TrangThaiThanhToan NVARCHAR(50)
AS
BEGIN
    -- Cập nhật trạng thái thanh toán
    UPDATE ThanhToanHoaDon
    SET TrangThaiThanhToan = @TrangThaiThanhToan
    WHERE MaHD = @MaHD AND MaKH = @MaKH AND MaPTTT = @MaPTTT;
END;
GO

--Xoa
CREATE PROCEDURE spXoaThanhToanHoaDon
    @MaHD NVARCHAR(10),
    @MaKH NVARCHAR(10),
    @MaPTTT NVARCHAR(10)
AS
BEGIN
    -- Xóa thanh toán hóa đơn
    DELETE FROM ThanhToanHoaDon WHERE MaHD = @MaHD AND MaKH = @MaKH AND MaPTTT = @MaPTTT;
END;
GO
--===================================================
--PROCEDURE kiểm tra tai khoan va mat khau
--===================================================
CREATE PROCEDURE spKiemTraDangNhap
    @TaiKhoan NVARCHAR(50),
    @MatKhau NVARCHAR(255)
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (SELECT 1 FROM NhanVien WHERE TaiKhoan = @TaiKhoan AND MatKhau = @MatKhau)
        SELECT 1 AS KetQua; -- Đăng nhập thành công
    ELSE
        SELECT 0 AS KetQua; -- Đăng nhập thất bại
END;
GO




