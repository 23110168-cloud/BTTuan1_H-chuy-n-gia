--===================================================
--PROCEDURE Thêm, cập nhật, xóa ChiTietHoaDon
--===================================================
--Them 
CREATE PROCEDURE spThemChiTietHoaDon
    @MaHD NVARCHAR(10),
    @MaSP NVARCHAR(10),
    @SoLuong INT
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRANSACTION;
    DECLARE @SoLuongTonKho INT, @Gia DECIMAL(15,2), @TongTien DECIMAL(15,2);

    -- Kiểm tra số lượng tồn kho
    SELECT @SoLuongTonKho = SoLuong, @Gia = Gia FROM SanPham WHERE MaSP = @MaSP;
    IF @SoLuongTonKho < @SoLuong
    BEGIN
        ROLLBACK;
        RAISERROR('Số lượng sản phẩm trong kho không đủ.', 16, 1);
        RETURN;
    END

    -- Cập nhật số lượng trong kho
    UPDATE SanPham
    SET SoLuong = SoLuong - @SoLuong
    WHERE MaSP = @MaSP;

    -- Thêm chi tiết hóa đơn
    INSERT INTO ChiTietHoaDon (MaHD, MaSP, SoLuong)
    VALUES (@MaHD, @MaSP, @SoLuong);

    -- Tính lại tổng tiền hóa đơn
    SELECT @TongTien = SUM(CTHD.SoLuong * SP.Gia)
    FROM ChiTietHoaDon CTHD
    JOIN SanPham SP ON CTHD.MaSP = SP.MaSP
    WHERE CTHD.MaHD = @MaHD;

    -- Cập nhật tổng tiền hóa đơn
    UPDATE HoaDon
    SET TongTien = ISNULL(@TongTien, 0)
    WHERE MaHD = @MaHD;

    COMMIT;
END;
GO


-- Cap Nhat
CREATE PROCEDURE spCapNhatChiTietHoaDon
    @MaHD NVARCHAR(10),
    @MaSP NVARCHAR(10),
    @SoLuongMoi INT
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRANSACTION;

    DECLARE @SoLuongCu INT, @SoLuongTonKho INT, @TongTien DECIMAL(15,2);

    -- Lấy số lượng cũ trong hóa đơn và số lượng tồn kho
    SELECT @SoLuongCu = CTHD.SoLuong, @SoLuongTonKho = SP.SoLuong
    FROM ChiTietHoaDon CTHD
    JOIN SanPham SP ON CTHD.MaSP = SP.MaSP
    WHERE CTHD.MaHD = @MaHD AND CTHD.MaSP = @MaSP;

    -- Kiểm tra số lượng tồn kho có đủ không
    IF (@SoLuongTonKho + @SoLuongCu) < @SoLuongMoi
    BEGIN
        ROLLBACK;
        RAISERROR('Số lượng sản phẩm trong kho không đủ.', 16, 1);
        RETURN;
    END

    -- Cập nhật số lượng trong kho
    UPDATE SanPham
    SET SoLuong = SoLuong + @SoLuongCu - @SoLuongMoi
    WHERE MaSP = @MaSP;

    -- Cập nhật số lượng trong chi tiết hóa đơn
    UPDATE ChiTietHoaDon
    SET SoLuong = @SoLuongMoi
    WHERE MaHD = @MaHD AND MaSP = @MaSP;

    -- Tính tổng tiền mới của hóa đơn
    SELECT @TongTien = SUM(CTHD.SoLuong * SP.Gia)
    FROM ChiTietHoaDon CTHD
    JOIN SanPham SP ON CTHD.MaSP = SP.MaSP
    WHERE CTHD.MaHD = @MaHD;

    -- Cập nhật tổng tiền hóa đơn
    UPDATE HoaDon
    SET TongTien = ISNULL(@TongTien, 0)
    WHERE MaHD = @MaHD;

    COMMIT;
END;
GO


--Xoa
CREATE PROCEDURE spXoaChiTietHoaDon
    @MaHD NVARCHAR(10),
    @MaSP NVARCHAR(10)
AS
BEGIN
    SET NOCOUNT ON;
    BEGIN TRANSACTION;

    DECLARE @SoLuong INT, @TongTien DECIMAL(15,2);

    -- Lấy số lượng sản phẩm trong hóa đơn trước khi xóa
    SELECT @SoLuong = SoLuong FROM ChiTietHoaDon WHERE MaHD = @MaHD AND MaSP = @MaSP;
    
    -- Nếu không tìm thấy sản phẩm trong hóa đơn, báo lỗi
    IF @SoLuong IS NULL
    BEGIN
        ROLLBACK;
        RAISERROR('Sản phẩm không tồn tại trong hóa đơn.', 16, 1);
        RETURN;
    END

    -- Cộng lại số lượng vào kho
    UPDATE SanPham
    SET SoLuong = SoLuong + @SoLuong
    WHERE MaSP = @MaSP;

    -- Xóa chi tiết hóa đơn
    DELETE FROM ChiTietHoaDon WHERE MaHD = @MaHD AND MaSP = @MaSP;

    -- Tính lại tổng tiền hóa đơn
    SELECT @TongTien = SUM(CTHD.SoLuong * SP.Gia)
    FROM ChiTietHoaDon CTHD
    JOIN SanPham SP ON CTHD.MaSP = SP.MaSP
    WHERE CTHD.MaHD = @MaHD;

    -- Cập nhật tổng tiền hóa đơn
    UPDATE HoaDon
    SET TongTien = ISNULL(@TongTien, 0)
    WHERE MaHD = @MaHD;

    COMMIT;
END;
GO

